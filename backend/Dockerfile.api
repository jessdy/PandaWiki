FROM --platform=$BUILDPLATFORM golang:1.24.3-alpine AS builder

WORKDIR /src
ENV CGO_ENABLED=0
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

ARG TARGETOS TARGETARCH VERSION
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" -o /build/panda-wiki-api cmd/api/main.go cmd/api/wire_gen.go \
    && GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" -o /build/panda-wiki-migrate cmd/migrate/main.go cmd/migrate/wire_gen.go 

# 雳鉴 IAST 主动插桩版：iast_go 只有 arm64 版且不支持 vendor/交叉编译，
# 仅当目标为 arm64 且构建上下文含 iast/go-active-linux-arm64 时产出 panda-wiki-api.iast，否则为空。
FROM golang:1.24.3-alpine AS iast-builder

WORKDIR /src
ENV CGO_ENABLED=0
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

COPY . .

ARG TARGETARCH VERSION
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    mkdir -p /build \
    && if [ "$TARGETARCH" = "arm64" ] && [ -f iast/go-active-linux-arm64 ]; then \
         install -m 0755 iast/go-active-linux-arm64 /usr/local/bin/iast_go \
         && rm -rf vendor \
         && iast_go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" \
              -o /build/panda-wiki-api.iast cmd/api/main.go cmd/api/wire_gen.go; \
       else \
         echo "skip IAST build (arch=$TARGETARCH)"; \
       fi

FROM openeuler/openeuler:24.03-lts AS api

RUN dnf -y update \
    && dnf -y install ca-certificates tzdata shadow-utils \
    && update-ca-trust force-enable || true \
    && groupadd -g 10001 panda \
    && useradd -u 10001 -g panda -M -d /home/panda -s /sbin/nologin panda \
    && mkdir -p /home/panda /app/data/backups \
    && chown -R panda:panda /home/panda /app/data \
    && dnf clean all

# runtime 中 pg.go 使用的是编译时的源码路径（/src/store/pg/migration），
# 所以这里需要把迁移文件复制到同样的路径，避免 "file:///src/store/pg/migration" 找不到。
RUN mkdir -p /src/store/pg/migration

WORKDIR /app

COPY --from=builder --chown=panda:panda /build/panda-wiki-api /app/panda-wiki-api
COPY --from=builder --chown=panda:panda /build/panda-wiki-migrate /app/panda-wiki-migrate
COPY --from=iast-builder --chown=panda:panda /build/ /app/
COPY --from=builder --chown=panda:panda /src/store/pg/migration /app/migration
COPY --from=builder --chown=panda:panda /src/store/pg/migration /src/store/pg/migration
COPY --chown=panda:panda iast/go-moresec-agent.toml.template /app/iast/go-moresec-agent.toml.template
COPY --chown=panda:panda --chmod=0755 iast/entrypoint.sh /app/iast/entrypoint.sh

ENV HOME=/home/panda

USER panda

ENTRYPOINT ["/app/iast/entrypoint.sh"]
CMD ["sh", "-c", "echo '🚀 panda-wiki-api container starting' && echo '📦 Running DB migration...' && /app/panda-wiki-migrate && echo '✅ Migration done' && echo '🎯 Starting API server (port 8000)...' && echo '' && exec /app/panda-wiki-api${IAST_SUFFIX:-}"]
