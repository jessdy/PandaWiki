# 雳鉴 Golang 主动插桩镜像（api）
# 构建上下文：backend/
# 需先将 arm/iast/go-active-linux-arm64 复制为 iast/go-active-linux-arm64（见 arm/iast/build-iast-images.sh）
# 仅支持 linux/arm64（当前仅提供 arm64 版 iast_go）
#
# 示例：
#   docker build --platform linux/arm64 -f backend/Dockerfile.api.iast -t panda-wiki-api:prod-iast backend

FROM --platform=linux/arm64 golang:1.24.3-alpine AS builder

WORKDIR /src
ENV CGO_ENABLED=0

# 主动插桩编译器（不支持 vendor）
COPY iast/go-active-linux-arm64 /usr/local/bin/iast_go
RUN chmod +x /usr/local/bin/iast_go

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

# 文档：暂时不支持 vendor，确保用 go mod 解析依赖
RUN rm -rf vendor

ARG VERSION
# migrate 无需插桩；api 用 iast_go 编译
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" \
      -o /build/panda-wiki-migrate cmd/migrate/main.go cmd/migrate/wire_gen.go \
    && iast_go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" \
      -o /build/panda-wiki-api cmd/api/main.go cmd/api/wire_gen.go

FROM --platform=linux/arm64 alpine:3.21 AS api

RUN apk update \
    && apk upgrade \
    && apk add --no-cache ca-certificates tzdata \
    && update-ca-certificates 2>/dev/null || true \
    && rm -rf /var/cache/apk/* \
    && adduser -D -u 10001 panda

# runtime 中 pg.go 使用编译时源码路径 /src/store/pg/migration
RUN mkdir -p /src/store/pg/migration

WORKDIR /app

COPY --from=builder --chown=panda:panda /build/panda-wiki-api /app/panda-wiki-api
COPY --from=builder --chown=panda:panda /build/panda-wiki-migrate /app/panda-wiki-migrate
COPY --from=builder --chown=panda:panda /src/store/pg/migration /app/migration
COPY --from=builder --chown=panda:panda /src/store/pg/migration /src/store/pg/migration
COPY --chown=panda:panda iast/go-moresec-agent.toml.template /app/iast/go-moresec-agent.toml.template
COPY --chown=panda:panda iast/entrypoint.sh /app/iast/entrypoint.sh
RUN chmod +x /app/iast/entrypoint.sh

ENV HOME=/home/panda

USER panda

ENTRYPOINT ["/app/iast/entrypoint.sh"]
CMD ["sh", "-c", "echo '🚀 panda-wiki-api (IAST) starting' && echo '📦 Running DB migration...' && /app/panda-wiki-migrate && echo '✅ Migration done' && echo '🎯 Starting API server (port 8000)...' && echo '' && exec /app/panda-wiki-api"]
